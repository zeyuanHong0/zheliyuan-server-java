server:
  port: 3000

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/blog_db?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: root
    driver-class-name: com.mysql.cj.jdbc.Driver

app:
  jwt:
    secret: replace-with-local-jwt-secret
  github:
    client-id: replace-with-github-client-id
    client-secret: replace-with-github-client-secret
    callback-url: http://localhost:3000/api/auth/github/callback
    redirect-page: http://localhost:5173/auth/success
  deepseek:
    api-key: replace-with-deepseek-api-key
    base-url: https://api.deepseek.com
  miniapp:
    app-id: replace-with-miniapp-appid
    secret: replace-with-miniapp-secret
    owner-openid: replace-with-miniapp-owner-openid
  cos:
    secret-id: replace-with-cos-secret-id
    secret-key: replace-with-cos-secret-key
    bucket: replace-with-cos-bucket
    region: replace-with-cos-region
  email:
    host: replace-with-email-host
    port: 465
    auth-user: replace-with-email-auth-user
    auth-pass: replace-with-email-auth-pass
    from: replace-with-email-from
  proxy:
    host: 127.0.0.1
    port: 7890
