<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.zly.blogbackjava.mapper.MiniappUserMapper">
    <resultMap id="WxUserResultMap" type="org.zly.blogbackjava.entity.WxUser">
        <id property="id" column="id"/>
        <result property="openid" column="openid"/>
        <result property="createTime" column="createTime"/>
        <result property="updateTime" column="updateTime"/>
        <result property="isDelete" column="is_delete"/>
    </resultMap>

    <select id="findByOpenid" resultMap="WxUserResultMap">
        SELECT id, openid, createTime, updateTime, is_delete
        FROM wx_user
        WHERE openid = #{openid} AND is_delete = 0
        LIMIT 1
    </select>

    <select id="findByIdAndOpenid" resultMap="WxUserResultMap">
        SELECT id, openid, createTime, updateTime, is_delete
        FROM wx_user
        WHERE id = #{id} AND openid = #{openid} AND is_delete = 0
        LIMIT 1
    </select>

    <insert id="insertMiniappUser" parameterType="org.zly.blogbackjava.entity.WxUser">
        INSERT INTO wx_user (id, openid)
        VALUES (#{id}, #{openid})
    </insert>
</mapper>
