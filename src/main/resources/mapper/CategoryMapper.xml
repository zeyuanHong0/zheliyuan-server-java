<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.zly.blogbackjava.mapper.CategoryMapper">
    <resultMap id="CategoryResultMap" type="org.zly.blogbackjava.entity.Category">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="createTime" column="createTime"/>
        <result property="updateTime" column="updateTime"/>
        <result property="isDelete" column="is_delete"/>
    </resultMap>

    <select id="getCategoryListByPage" resultMap="CategoryResultMap">
        SELECT * FROM category
        <where>
            <if test="name != null and name.trim() != ''">
                name LIKE CONCAT('%', #{name}, '%')
            </if>
            AND is_delete = 0
        </where>
        ORDER BY createTime DESC , id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="countCategoryList" resultType="java.lang.Long">
        SELECT COUNT(*)
        FROM category
        <where>
            <if test="name != null and name.trim() != ''">
                name LIKE CONCAT('%', #{name}, '%')
            </if>
            AND is_delete = 0
        </where>
    </select>

    <select id="getAllCategoryList" resultMap="CategoryResultMap">
        SELECT * FROM category
        WHERE is_delete = 0
        ORDER BY createTime DESC
    </select>

    <select id="getCategoryById" resultMap="CategoryResultMap">
        SELECT * FROM category
        WHERE id = #{id} AND is_delete = 0
    </select>

    <insert id="insertCategory">
        INSERT INTO category (id, name)
        VALUES (#{id}, #{name})
    </insert>

    <select id="countAllCategory" resultType="Integer">
        SELECT COUNT(*)
        FROM category
        WHERE is_delete = 0
    </select>

    <update id="updateCategory">
        UPDATE category
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="isDelete != null">is_delete = #{isDelete},</if>
        </set>
        WHERE id = #{id}
    </update>


</mapper>
