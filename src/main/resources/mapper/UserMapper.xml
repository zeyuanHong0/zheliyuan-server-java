<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.zly.blogbackjava.mapper.UserMapper">
    <resultMap id="UserResultMap" type="org.zly.blogbackjava.entity.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="email" column="email"/>
        <result property="accountType" column="accountType"/>
        <result property="createTime" column="createTime"/>
        <result property="updateTime" column="updateTime"/>
        <result property="deleted" column="is_deleted"/>
    </resultMap>
    <resultMap id="UserWithOauthsMap" type="User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="email" column="email"/>
        <result property="accountType" column="accountType"/>
        <result property="createTime" column="createTime"/>
        <result property="updateTime" column="updateTime"/>
        <result property="deleted" column="is_deleted"/>
        <collection property="userOauths" ofType="UserOauth">
            <id property="id" column="oauth_id"/>
            <result property="provider" column="provider"/>
            <result property="providerId" column="providerId"/>
            <result property="userId" column="userId"/>
        </collection>
    </resultMap>

    <select id="findByEmail" resultMap="UserResultMap">
        SELECT * FROM users
        WHERE email = #{email}
        LIMIT 1
    </select>

    <select id="findByEmailWithOauths" resultMap="UserWithOauthsMap">
        SELECT u.*,o.id as oauth_id, o.provider, o.providerId, o.userId
        FROM users u
        LEFT JOIN user_oauth o ON u.id = o.userId
        WHERE u.email = #{email}
    </select>

    <select id="findByUserName" resultMap="UserResultMap">
        SELECT * FROM users
        WHERE username = #{username}
    </select>

    <insert id="insertUser">
        INSERT INTO users (id, username, password, email, accountType)
        VALUES (#{id}, #{username}, #{password}, #{email}, #{accountType})
    </insert>

    <update id="updateUser">
        UPDATE users
        SET password = #{password}, username = #{username}
        WHERE id = #{id}
    </update>

</mapper>
