<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.zly.blogbackjava.mapper.StatusMapper">

    <resultMap id="StatusResultMap" type="org.zly.blogbackjava.entity.Status">
        <result property="isOnline" column="is_online"/>
        <result property="statusText" column="status_text"/>
        <result property="statusDesc" column="status_desc"/>
    </resultMap>


    <select id="getStatus" resultMap="StatusResultMap">
        SELECT id, is_online, status_text, status_desc
        FROM status
    </select>

    <update id="updateStatus">
        UPDATE status
        SET is_online = #{isOnline},
        status_text = #{statusText},
        status_desc = #{statusDesc}
    </update>
</mapper>
