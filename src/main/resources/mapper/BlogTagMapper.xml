<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.zly.blogbackjava.mapper.BlogTagMapper">

    <insert id="insert">
        INSERT INTO blog_tags (blogId, tagId)
        VALUES (#{blogId}, #{tagId})
    </insert>

    <delete id="deleteByBlogId" parameterType="string">
        DELETE FROM blog_tags
        WHERE blogId = #{blogId}
    </delete>
</mapper>
